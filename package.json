{
  "name": "@limitlesspc/eslint-config",
  "type": "module",
  "version": "0.24.1",
  "packageManager": "pnpm@10.25.0",
  "description": "ESLint config",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "fmt": "prettier . --write --ignore-unknown",
    "build": "nr gen && tsdown --clean --dts",
    "stub": "tsdown",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build --stats --config eslint.config.ts --out-dir ./.eslint-config-inspector",
    "watch": "tsdown --watch",
    "lint": "eslint",
    "gen": "tsx scripts/typegen.ts",
    "prepack": "nr build",
    "release": "bumpp",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^9.10.0 || ^10.0.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.1",
    "eslint-plugin-svelte": ">=2.35.1",
    "svelte-eslint-parser": ">=0.37.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-erasable-syntax-only": {
      "optional": true
    },
    "eslint-plugin-svelte": {
      "optional": true
    },
    "svelte-eslint-parser": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/install-pkg": "^2.1.0",
    "@clack/prompts": "^1.8.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-merge-processors": "^2.0.0",
    "eslint-plugin-antfu": "^3.3.1",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-import-lite": "^0.6.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-regexp": "^3.3.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "local-pkg": "^1.2.1"
  },
  "devDependencies": {
    "@antfu/ni": "^30.6.0",
    "@eslint/config-inspector": "^3.5.0",
    "@limitlesspc/eslint-config": "workspace:*",
    "@limitlesspc/prettier-config": "^1.2.1",
    "@types/node": "^26.6.6",
    "baseline-browser-mapping": "^2.11.34",
    "bumpp": "^12.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-typegen": "^2.3.2",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "svelte": "^5.57.3",
    "svelte-eslint-parser": "^1.10.0",
    "tsdown": "^0.23.4",
    "tsdown-stale-guard": "^0.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "@eslint-community/eslint-utils": "^4.10.1",
    "@typescript-eslint/types": "^8.72.0",
    "@typescript-eslint/utils": "^8.72.0",
    "chokidar": "^6.0.0",
    "eslint": "^9.39.5",
    "semver": "^7.8.5",
    "synckit": "^0.12.3",
    "tsx": "^4.23.15"
  }
}
